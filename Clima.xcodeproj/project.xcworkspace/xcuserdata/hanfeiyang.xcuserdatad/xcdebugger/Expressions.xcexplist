<?xml version="1.0" encoding="UTF-8"?>
<VariablesViewState
   version = "1.0">
   <ContextStates>
      <ContextState
         contextName = "WeatherViewController.searchPressed(_:):WeatherViewController.swift">
         <PersistentStrings>
            <PersistentString
               value = "searchTextField.text!">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "WeatherViewController.textFieldDidEndEditing(_:):WeatherViewController.swift">
         <PersistentStrings>
            <PersistentString
               value = "searchTextField.text">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
   </ContextStates>
</VariablesViewState>
